{
  "name": "coldmail-pro",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "postinstall": "prisma generate",
    "build": "node scripts/clean-build.mjs && next build && tsc -p tsconfig.worker.json",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "worker:dev": "tsx -r dotenv/config worker/worker.ts",
    "worker:prod": "node -r dotenv/config worker-dist/worker.js",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "imapflow": "^1.0.175",
    "jose": "^5.9.6",
    "mailparser": "^3.7.1",
    "next": "^14.2.14",
    "nodemailer": "^6.9.14",
    "otplib": "^12.0.1",
    "p-limit": "^6.1.0",
    "ping-email": "^1.0.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-toastify": "^10.0.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "googleapis": "^134.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.14",
    "postcss": "^8.4.41",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
