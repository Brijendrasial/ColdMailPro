# App
PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=change_me_to_a_long_random_string
# Recommended: independent 32-byte encryption key (base64/base64url). If omitted, JWT_SECRET is used.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=

# Recommended: HMAC secret for signed tracking links. If omitted, JWT_SECRET is used.
TRACKING_LINK_SECRET=
COOKIE_NAME=coldmail_session
NODE_ENV=production

# Database (MariaDB)
DATABASE_URL="mysql://coldmail:ColdmailPass123@127.0.0.1:3306/coldmail"

# Shadow database (Prisma migrate)
SHADOW_DATABASE_URL="mysql://coldmail:ColdmailPass123@127.0.0.1:3306/coldmail_shadow"

# Worker
WORKER_CONCURRENCY=10
SEND_TICK_SECONDS=10
IMAP_POLL_MINUTES=1
# Optional: faster Replies inbox polling. 30 = near real-time without hammering IMAP.
IMAP_POLL_SECONDS=30
# Global pacing: add a random delay between sends per mailbox.
# This prevents sending to all leads "instantly" when you start a campaign.
# Example: 60-180 means each mailbox will send 1 email every 1-3 minutes.
SEND_GAP_MIN_SECONDS=60
SEND_GAP_MAX_SECONDS=180
# Enable verbose IMAP debug logs (set to 1 temporarily when IMAP sync shows only "Command failed")
DEBUG_IMAP=0

# TEMP: If your mail server TLS certificate does not match the hostname you configured
# (eg. cert is for srv1.* but you use mail.yourdomain.com), set this to 1.
# Best practice is to fix the certificate to include your mail hostname.
SMTP_TLS_SKIP_VERIFY=0


# Tracking
TRACKING_PIXEL_PATH=/t/open
TRACKING_CLICK_PATH=/t/click

# Optional: bind local IP when sending (if you have multiple IPs on server)
# If blank, default OS routing.
DEFAULT_SMTP_LOCAL_ADDRESS=

# Security
ALLOWED_ORIGINS=http://localhost:3000

# Mailstack scripts on the server (for provisioning worker)
MAILSTACK_SCRIPT=./scripts/mailstack.sh
MAILSTACK_ADDON_SCRIPT=./scripts/mailstack-addon.sh

# Used for Let's Encrypt account registration when issuing TLS certs for mail.<domain>
# Must be a real email (domain must contain a dot)
MAILSTACK_ACME_EMAIL=you@yourdomain.com

# --- Mailbox monitoring (Upgrade C) ---
# Automatically enqueue mailbox SMTP/IMAP health checks on a schedule.
AUTO_HEALTHCHECK_ENABLED=1
# How often the worker should run the healthcheck sweep.
HEALTHCHECK_POLL_MINUTES=60
# If the last healthcheck is older than this, worker will enqueue a fresh one.
HEALTHCHECK_STALE_HOURS=12

# --- Domain DNS monitoring (Upgrade D) ---
# Automatically enqueue domain DNS checks (SPF/DKIM/DMARC/MX + Cloudflare view).
AUTO_DOMAIN_DNSCHECK_ENABLED=1
# How often the worker should run the domain DNS sweep (minutes).
DOMAIN_DNSCHECK_POLL_MINUTES=720
# If the last DNS check is older than this, worker will enqueue a fresh one.
DOMAIN_DNSCHECK_STALE_HOURS=24

# --- Blacklist monitoring (v2.0.7+) ---
# Automatically check all configured sending domains and outbound IPs against DNSBL/domain blacklist providers.
AUTO_BLACKLIST_CHECK_ENABLED=true
# How often the worker should run the blacklist sweep (minutes). 720 = every 12 hours.
BLACKLIST_CHECK_POLL_MINUTES=720
# Recheck assets if the last blacklist result is older than this many hours.
BLACKLIST_CHECK_STALE_HOURS=24
# DNS lookup timeout per blacklist provider. Increase if your resolver/network is slow.
BLACKLIST_DNS_TIMEOUT_MS=4500
# Number of blacklist lookups to run in parallel. Lower this on small VPS servers.
BLACKLIST_CHECK_CONCURRENCY=5
# Optional: force blacklist checks to use a trusted/local resolver instead of the OS resolver.
# Recommended after installing Unbound for accurate DNSBL/URIBL checks.
BLACKLIST_DNS_RESOLVERS=127.0.0.1


# --- Warmup suite (Option B) ---
# Enable automatic warmup scheduling in the worker.
AUTO_WARMUP_ENABLED=1
# Enable verbose warmup debugging logs in worker stdout + JobLog.
WARMUP_DEBUG=0
# How often the worker enqueues warmup ticks (minutes).
WARMUP_POLL_MINUTES=10
# How often the worker checks seed inbox placement via IMAP (minutes).
WARMUP_SEEDCHECK_POLL_MINUTES=10
# Consider a warmup tick stale if last activity is older than this (minutes).
WARMUP_STALE_MINUTES=30

# Warmup pacing + thread realism
# Minimum minutes between warmup sends from the same mailbox (prevents bursts).
WARMUP_MIN_GAP_MINUTES=15
# Chance to continue an existing warmup thread instead of starting a new one.
WARMUP_THREAD_REUSE_RATE=0.50
# Hard cap on messages per warmup thread; threads auto-close at this length.
WARMUP_THREAD_MAX_MESSAGES=4
# Chance to schedule a follow-up after an internal warmup reply (creates multi-turn threads).
WARMUP_FOLLOWUP_RATE=0.35
# Follow-up delay window (minutes).
WARMUP_FOLLOWUP_MIN_DELAY_MIN=60
WARMUP_FOLLOWUP_MAX_DELAY_MIN=240

# Auto-safety: disable warmup if placement spikes to spam.
# If enabled, the worker will automatically turn off Mailbox.warmupEnabled (and WarmupProfile.isActive)
# when spam rate exceeds WARMUP_SPAM_SPIKE_RATE over the last WARMUP_SPAM_SPIKE_WINDOW_HOURS.
WARMUP_AUTO_DISABLE_ON_SPAM=0
WARMUP_SPAM_SPIKE_WINDOW_HOURS=24
WARMUP_SPAM_SPIKE_MIN_MESSAGES=6
WARMUP_SPAM_SPIKE_RATE=0.50

# If true, when a warmup email lands in Spam/Junk of a seed inbox, attempt to move it to INBOX (train not-spam).
WARMUP_SEED_RESCUE_SPAM=0

# Seed engagement simulation (enterprise warmup)
# When enabled, seed checker will simulate engagement by marking warmup emails as read/starred,
# optionally archiving after rescue.
WARMUP_SEED_ENGAGE=1
WARMUP_SEED_ENGAGE_OPEN_RATE=0.85
WARMUP_SEED_ENGAGE_STAR_RATE=0.35
WARMUP_SEED_ENGAGE_ARCHIVE_RATE=0.15

# Seed auto-reply (requires SMTP config saved on each Seed inbox)
# When enabled, worker will sometimes send a short reply from the seed inbox back to the warmed mailbox.
WARMUP_SEED_AUTOREPLY=1
WARMUP_SEED_AUTOREPLY_RATE=0.30
WARMUP_SEED_AUTOREPLY_MIN_DELAY_MIN=5
WARMUP_SEED_AUTOREPLY_MAX_DELAY_MIN=35

# Warmup AI (templates generation)
# OpenAI-compatible API (OpenAI / OpenRouter / local gateway etc.)
WARMUP_AI_ENABLED=0

# Leads AI (tag/segment suggestions)
# Uses the same AI_* settings above.
LEADS_AI_ENABLED=0

# Replies AI (auto-triage + optional autopilot in Replies tab)
REPLIES_AI_ENABLED=0

# --- Google Calendar (meeting scheduling for Replies AI) ---
# Create a Google Cloud OAuth Client (Web application) and set the redirect URL to:
#   ${PUBLIC_APP_URL}/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: if omitted, defaults to ${PUBLIC_APP_URL}/api/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URL=
# Optional (space-separated). Defaults to calendar.events + userinfo.email
GOOGLE_OAUTH_SCOPES=

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000

# --- AI Web Search (use OpenAI Responses API with built-in web_search tool) ---
# If enabled, lead email discovery/enrich will ask the AI to search the public web (like ChatGPT)
# instead of your server crawling the website HTML.
AI_WEBSEARCH_ENABLED=1
# Recommend a model that supports web search tool (see OpenAI docs).
AI_WEBSEARCH_MODEL=gpt-5
# Safety cap on number of web search tool calls per request.
AI_WEBSEARCH_MAX_TOOL_CALLS=3
AI_WEBSEARCH_TIMEOUT_MS=120000


# --- Unified App Logging ---
# If set, middleware will authenticate to /api/logs/ingest using this token.
# If not set, /api/logs/ingest only accepts authenticated (session) calls.
INTERNAL_LOG_TOKEN=your-long-random-token

# Enable/disable DB log sink (AppLog table)
APPLOG_DB=1

# Minimum level to store in DB: debug | info | warn | error
APPLOG_LEVEL=info

# Log Prisma queries slower than this (ms)
PRISMA_SLOW_MS=150
PRISMA_LOG_WRITES=1
PRISMA_LOG_READS=0

# Optional: retention (days). Not auto-enforced unless you run cleanup.
LOG_RETENTION_DAYS=30


# Lead email verification (ping-email)
# Set PING_EMAIL_ENABLED=1 to enable the "Verify before saving" option in Leads.
# fqdn should be your server's real hostname (PTR/rDNS friendly if possible).
PING_EMAIL_ENABLED=0
PING_EMAIL_FQDN=mail.example.org
PING_EMAIL_SENDER=verify@example.org
PING_EMAIL_PORT=25
PING_EMAIL_TIMEOUT_MS=10000
PING_EMAIL_ATTEMPTS=3
# If 1, skips SMTP RCPT verification (syntax+domain+MX only) to reduce block risk.
PING_EMAIL_IGNORE_SMTP_VERIFY=0
PING_EMAIL_DEBUG=0


# AutoFix (worker self-healing)
AUTOFIX_ENABLED=true
AUTOFIX_AUTO_APPLY_SAFE=true
AUTOFIX_AI_SUGGESTIONS=true
AUTOFIX_MAX_SAFE_ATTEMPTS_PER_JOB=1

# AIOps (incidents + suggestions)
AIOPS_ENABLED=true
AIOPS_AI_ANALYSIS=true
AIOPS_CAPTURE_LOG_TAIL=true
AIOPS_LOG_TAIL_LINES=120
AIOPS_MAX_OPEN_INCIDENTS_PER_SIGNATURE=1
# Safety: keep false unless you explicitly expand safe allowlist
AIOPS_APPLY_SAFE_FROM_AI=false
